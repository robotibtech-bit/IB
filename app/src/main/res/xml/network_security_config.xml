<?xml version="1.0" encoding="utf-8"?>
<!--
    기본은 평문(HTTP) 통신을 막는 안드로이드 기본값을 그대로 따른다. 도서관 자체 시스템이라
    HTTPS를 지원하지 않는 곳만 예외로 허용한다.
    - seat8.ice.go.kr: 열람실 실시간 좌석 현황(홈 > 실시간 좌석 · 예약현황 > 열람실 좌석현황)
    - digital8.ice.go.kr: 디지털자료실(LibMate) 예약현황(홈 > 실시간 좌석 · 예약현황 > 디지털자료실 예약현황)

    도서검색 서버(홈 > 책 찾기)는 도서관 내부망에 HTTP 로 뜬다. release 빌드에서 쓰려면
    실제 서버 호스트/IP 를 아래 목록에 추가해야 한다 — 추가하지 않으면 연결이
    `CLEARTEXT communication ... not permitted` 로 막힌다. 디버그 빌드는
    `src/debug/res/xml/network_security_config.xml` 이 평문을 전면 허용하므로 개발 중에는
    이 목록을 건드리지 않아도 된다.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">seat8.ice.go.kr</domain>
        <domain includeSubdomains="false">digital8.ice.go.kr</domain>
        <!-- TODO(배포): 도서검색 서버의 실제 호스트/IP 로 교체 (예: 192.168.0.50) -->
    </domain-config>
</network-security-config>
